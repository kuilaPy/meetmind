{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["meeting_summary", "key_decisions", "discussions", "action_items", "open_questions", "follow_up_items"],
  "properties": {
    "meeting_summary": {"type": "string"},
    "key_decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "discussions": {"type": "array", "items": {"type": "object", "required": ["topic", "notes"], "properties": {"topic": {"type": "string"}, "notes": {"type": "string"}}}},
    "action_items": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "open_questions": {"type": "array", "items": {"type": "object", "required": ["question"], "properties": {"question": {"type": "string"}, "owner": {"type": ["string", "null"]}}}},
    "follow_up_items": {"type": "array", "items": {"type": "object", "required": ["item", "owner"], "properties": {"item": {"type": "string"}, "owner": {"type": ["string", "null"]}}}}
  },
  "$defs": {
    "decision": {"type": "object", "required": ["decision", "evidence", "speaker", "confidence"], "properties": {"decision": {"type": "string"}, "evidence": {"type": "string"}, "speaker": {"type": ["string", "null"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}},
    "action": {"type": "object", "required": ["task", "owner", "deadline", "status", "evidence", "speaker", "confidence"], "properties": {"task": {"type": "string"}, "owner": {"type": ["string", "null"]}, "deadline": {"type": ["string", "null"], "format": "date"}, "status": {"enum": ["pending", "in_progress", "completed", "blocked"]}, "evidence": {"type": "string"}, "speaker": {"type": ["string", "null"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}
  }
}
